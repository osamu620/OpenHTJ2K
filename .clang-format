BasedOnStyle: Google
UseTab: Never
IndentWidth: 2
AccessModifierOffset: -1
AlignConsecutiveAssignments: Consecutive
AlignTrailingComments: true
ColumnLimit: 108
SortIncludes: Never
BreakBeforeBinaryOperators: NonAssignment
IndentPPDirectives: BeforeHash
# Format the C++11-compatible `if constexpr` wrapper like an if statement.
IfMacros: [OPENHTJ2K_IF_CONSTEXPR]
